#!/bin/bash

function g_echo_error {

 [ -z "$1" ] && return 1

 # ANSI colors only when stderr is a terminal (keeps pipe and log output clean)
 local f_mcolor="\033[97m"
 local f_tcolor="\033[31m"
 local f_reset="\033[0m"
 if [[ ! -t 2 ]] || [[ -n ${NO_COLOR+x} ]]
 then
  f_mcolor=""
  f_tcolor=""
  f_reset=""
 fi

 if [[ -n ${FUNCNAME[1]} ]]
 then
   printf "${f_mcolor}%(%Y-%m-%d %H:%M:%S)T ${f_tcolor}[${FUNCNAME[1]}] ERROR: %s${f_reset}\n" -1 "$*" 1>&2
 else
   printf "${f_mcolor}%(%Y-%m-%d %H:%M:%S)T ${f_tcolor}ERROR: %s${f_reset}\n" -1 "$*" 1>&2
 fi

 g_logger ERROR: $@
 if ! [ $0 = /usr/local/bin/notify.sh ]
 then
  if [ -x /usr/local/bin/notify.sh ]
  then
   cat <<< "$(date "+%F %T") $(hostname) $0[$$] ERROR: $@" | tail -n 100 | /usr/local/bin/notify.sh
  fi
 fi
 [ -z $DISPLAY ] || zenity --error --ellipsize --text="$@"

 if [ -n "$HEALTHCHECK_FILE" ]
 then
   echo "ERROR:${g_scriptname}[${FUNCNAME[1]}]:$@" | head -n1 >>"$HEALTHCHECK_FILE"
 fi
}
