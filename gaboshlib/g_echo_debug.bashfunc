#!/bin/bash

function g_echo_debug {
 [[ $g_debug -gt 0 ]] || return 0
 [[ -z "$1" ]] && return 1

 # ANSI colors only when stdout is a terminal (keeps pipe and log output clean)
 local f_mcolor="\033[97m"
 local f_tcolor="\033[35m"
 local f_reset="\033[0m"
 if [[ ! -t 1 ]] || [[ -n ${NO_COLOR+x} ]]
 then
  f_mcolor=""
  f_tcolor=""
  f_reset=""
 fi

 if [[ -n ${FUNCNAME[1]} ]]
 then
   printf "${f_mcolor}%(%Y-%m-%d %H:%M:%S)T ${f_tcolor}$0[$$ ${FUNCNAME[1]}] DEBUG: %s${f_reset}\n" -1 "$*"
 else
   printf "${f_mcolor}%(%Y-%m-%d %H:%M:%S)T ${f_tcolor}$0[$$] DEBUG: %s${f_reset}\n" -1 "$*"
 fi
 return 0
}

function g_echo_debug_vars {
 set -o posix; set  | grep '^[a-z].*='
 return 0
}
