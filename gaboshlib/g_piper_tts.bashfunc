#!/bin/bash
# gaboshlib function: convert text to speech (Piper TTS) over the network
# Talks to a piper tts proxy (OpenAI-compatible /v1/audio/speech) directly via HTTP.

function g_piper_tts {

 # default settings
 local g_pi_speed="0.6"
 local g_pi_voice="alloy"
 local g_pi_host="localhost"
 local g_pi_port="8083"
 local g_pi_file=""
 local g_pi_out=""
 local g_pi_text=""

 # derive the default output name from the input for later use
 function f_piper_tts_usage {
  cat <<EOF
Usage: $(basename "$0") -i <input> [-o <output.wav>] [OPTIONS]

Convert text to audio using Piper TTS.

Arguments:
  -i FILE     Input text FILE or literal text string (required)
  -o FILE     Output audio file (default: <input>.wav)
  -s SPEED    Speaking speed (default: 0.6)
  -v VOICE    Voice name (default: alloy, all map to de_DE-ramona-low)
  -h HOST     TTS server host (default: localhost)
  -p PORT     TTS server port (default: 8083)
  --help      Show this help

Examples:
  g_piper_tts -i artikel.txt -o sprache.wav
  g_piper_tts -i artikel.txt -o sprache.wav -h localhost -p 8083 -s 0.6
  g_piper_tts -i "ein Text direkt übergeben" -o text.wav
EOF
  return 0
 }

 # parse options
 while [[ $# -gt 0 ]]
 do
  case "$1" in
   -i) g_pi_file="$2"; shift 2 ;;
   -o) g_pi_out="$2"; shift 2 ;;
   -s) g_pi_speed="$2"; shift 2 ;;
   -v) g_pi_voice="$2"; shift 2 ;;
   -h) g_pi_host="$2"; shift 2 ;;
   -p) g_pi_port="$2"; shift 2 ;;
   --help|-help) f_piper_tts_usage; return 0 ;;
   -*) g_echo_error "Unknown option: $1"; f_piper_tts_usage; return 1 ;;
   *) g_echo_error "Unexpected argument: $1"; f_piper_tts_usage; return 1 ;;
  esac
 done

 # require an input
 if [[ -z "$g_pi_file" ]]
 then
  g_echo_error "No input file or text specified."
  f_piper_tts_usage
  return 1
 fi

 # build the base URL
 local g_pi_url="http://${g_pi_host}:${g_pi_port}"

 # decide whether the input is a file or a literal text string
 if [[ -f "$g_pi_file" ]]
 then
  # input is a file: use text from it and default output from its name
  g_pi_text=$(cat "$g_pi_file")
  if [[ -z "$g_pi_out" ]]
  then
   g_pi_out="${g_pi_file%.*}.wav"
  fi
 else
  # input is a literal text string
  g_pi_text="$g_pi_file"
  if [[ -z "$g_pi_out" ]]
  then
   g_echo_error "No output file given for text input."
   return 1
  fi
 fi

 # build JSON payload into a temp file (avoids shell quoting problems)
 local g_pi_payload="$g_tmp/piper_tts_payload.json"
 python3 -c 'import json,sys; print(json.dumps({"input":sys.argv[1],"voice":sys.argv[2],"speed":float(sys.argv[3])}))' \
  "$g_pi_text" "$g_pi_voice" "$g_pi_speed" > "$g_pi_payload" 2>/dev/null

 # send request directly to the TTS service, capture only the WAV bytes
 if ! curl -s --max-time 1800 -X POST "${g_pi_url}/v1/audio/speech" \
   -H 'Content-Type: application/json' \
   -d @"$g_pi_payload" > "$g_pi_out"
 then
  g_echo_error "Synthesis failed."
  return 1
 fi

 g_echo_ok "Done! Output: $g_pi_out ($(du -h "$g_pi_out" | cut -f1))"
 return 0
}
