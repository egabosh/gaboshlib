#!/bin/bash

function g_echo {
 [ -z "$1" ] && return 0

 # ANSI colors only when stdout is a terminal (keeps pipe and log output clean)
 local f_mcolor="\033[97m"
 local f_tcolor="\033[97m"
 local f_reset="\033[0m"
 if [[ ! -t 1 ]] || [[ -n ${NO_COLOR+x} ]]
 then
  f_mcolor=""
  f_tcolor=""
  f_reset=""
 fi

 if [[ -n ${FUNCNAME[1]} ]]
 then
   printf "${f_mcolor}%(%Y-%m-%d %H:%M:%S)T ${f_tcolor}[${FUNCNAME[1]}] %s${f_reset}\n" -1 "$*"
 else
   printf "${f_mcolor}%(%Y-%m-%d %H:%M:%S)T ${f_tcolor}%s${f_reset}\n" -1 "$*"
 fi
 [ -z $g_alltosyslog ] && return 0
 g_logger $@
}
